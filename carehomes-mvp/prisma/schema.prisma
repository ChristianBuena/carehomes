generator client {
	provider = "prisma-client-js"
}

datasource db {
	provider = "postgresql"
}

enum UserRole {
	MEMBER
	ADMIN
}

enum RebuttalStatus {
	SUBMITTED
	NEEDS_FIX
	APPROVED
	REJECTED
}

model User {
	id              String   @id @default(cuid())
	email           String   @unique
	name            String
	password        String
	role            UserRole @default(MEMBER)
	// MFA fields
	mfaEnabled      Boolean  @default(false)
	mfaSecret       String?
	backupCodes     String[]
	createdAt       DateTime @default(now())
	updatedAt       DateTime @updatedAt

	rebuttalsCreated  Rebuttal[] @relation("RebuttalsCreated")
	rebuttalsReviewed Rebuttal[] @relation("RebuttalsReviewed")
}

model Facility {
	id       String     @id @default(cuid())
	name     String
	location String
	ccldLink String?
	createdAt DateTime  @default(now())
	updatedAt DateTime  @updatedAt

	rebuttals Rebuttal[]

	@@index([name])
	@@index([location])
}

model Rebuttal {
	id         String         @id @default(cuid())
	facilityId String
	title      String
	summary    String
	fileUrl    String?
	status     RebuttalStatus @default(SUBMITTED)
	createdBy  String
	createdAt  DateTime       @default(now())
	reviewedBy String?
	reviewedAt DateTime?

	facility  Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
	creator   User     @relation("RebuttalsCreated", fields: [createdBy], references: [id], onDelete: Cascade)
	reviewer  User?    @relation("RebuttalsReviewed", fields: [reviewedBy], references: [id], onDelete: SetNull)

	@@index([facilityId])
	@@index([createdBy])
	@@index([status])
	@@index([reviewedBy])
}
