generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

enum RebuttalStatus {
  PENDING
  APPROVED
  REJECTED
  REQUEST_FIX
}

enum MembershipPlan {
  NONE
  TIER_A
  TIER_B
  TIER_C
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
}

model MembershipAgreement {
  id String @id @default(cuid())

  version String @unique
  title   String
  content String

  isActive Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

//
// ORGANIZATION — multi-seat owner of one membership and N facilities
//

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  membership Membership?
  facilities Facility[]

  @@index([id])
}

//
// USER
//

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(MEMBER)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastReviewedAt DateTime?

  // ORGANIZATION (multi-seat)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // RELATIONS
  rebuttals          Rebuttal[]
  moderatedRebuttals Rebuttal[] @relation("ModeratedRebuttals")
  consentLogs         ConsentLog[]

  createdFacilities Facility[]
  citationDeadlines CitationDeadline[]

  moderationLogs ModerationLog[]

  uploadedTemplates Template[]         @relation("UploadedTemplates")
  templateDownloads TemplateDownload[] @relation("TemplateDownloads")

  assignedTakedowns TakedownRequest[]  @relation("AssignedTakedowns")
  resolvedTakedowns TakedownRequest[]  @relation("ResolvedTakedowns")

  @@index([email])
  @@index([organizationId])
}

//
// MEMBERSHIP (STRIPE + TIERS)
// Now owned by Organization, not User.
//

model Membership {
  id String @id @default(cuid())

  // Membership belongs to the Organization
  organizationId String @unique

  plan   MembershipPlan   @default(NONE)
  status MembershipStatus @default(INACTIVE)

  maxFacilities Int @default(0)

  stripeCustomerId     String?
  stripeSubscriptionId String?

  startDate       DateTime?
  endDate         DateTime?
  nextBillingDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([status])
}

//
// REBUTTAL SYSTEM
//

model Rebuttal {
  id             String         @id @default(cuid())
  title          String
  content        String
  documentUrl    String?
  watermarkedUrl String?
  status         RebuttalStatus @default(PENDING)

  // SOFT DELETE — set instead of hard-deleting rows
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // FACILITY LINK
  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  // MODERATION
  moderatedById String?
  moderatedBy   User?   @relation("ModeratedRebuttals", fields: [moderatedById], references: [id])

  moderationLogs   ModerationLog[]
  takedownRequests TakedownRequest[]

  // ── Indexes ────────────────────────────────────────────────────────────────
  // Core lookup
  @@index([userId])
  @@index([status])
  @@index([facilityId])
  // Soft-delete aware (always filter deletedAt = null in queries)
  @@index([deletedAt])
  // High-traffic composite: facility directory listing with status filter
  @@index([facilityId, status])
  @@index([deletedAt, facilityId, status])
  // Moderation queue: pending/fix rebuttals sorted by date
  @@index([status, updatedAt])
  @@index([deletedAt, status, updatedAt])
  // User dashboard: user's own rebuttals by status
  @@index([userId, status])
  @@index([deletedAt, userId, status])
}

//
// FACILITY SYSTEM
//

model Facility {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  address        String
  description    String?
  facilityNumber String?
  city           String?
  county         String?
  capacity       Int?
  ccldLink       String?

  // SOFT DELETE — set instead of hard-deleting rows
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // AUDIT TRAIL — who physically claimed this facility (never changes)
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // QUOTA SCOPE — which org owns this facility (used for limit checks)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  // REBUTTALS
  rebuttals Rebuttal[]

  // ── Indexes ────────────────────────────────────────────────────────────────
  // Core lookup
  @@index([slug])
  @@index([name])
  @@index([county])
  @@index([city])
  @@index([capacity])
  @@index([facilityNumber])
  @@index([createdById])
  @@index([organizationId])
  // Soft-delete aware
  @@index([deletedAt])
  // High-traffic composite: public directory filtered by active facilities
  @@index([deletedAt, name])
  @@index([deletedAt, slug])
  @@index([deletedAt, county])
  @@index([deletedAt, city])
  @@index([deletedAt, updatedAt])
  // Org quota check: count active facilities per org
  @@index([deletedAt, organizationId])
  @@index([organizationId, createdAt])
}

//
// MFA SYSTEM
//

model MfaOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime

  attempts Int     @default(0)
  used     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([email])
}

//
// CITATION DEADLINE SYSTEM
//

model CitationDeadline {
  id         String   @id @default(cuid())
  citationId String
  dueDate    DateTime
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, dueDate])
}

//
// MODERATION AUDIT TRAIL
//

model ModerationLog {
  id String @id @default(cuid())

  // WHAT CHANGED
  fromStatus RebuttalStatus
  toStatus   RebuttalStatus
  notes      String?

  // WHEN
  createdAt DateTime @default(now())

  // WHO
  moderatorId String
  moderator   User   @relation(fields: [moderatorId], references: [id])

  // WHICH rebuttal
  rebuttalId String
  rebuttal   Rebuttal @relation(fields: [rebuttalId], references: [id], onDelete: Cascade)

  @@index([rebuttalId])
  @@index([moderatorId])
  @@index([rebuttalId, createdAt])
  @@index([createdAt])
}

//
// ARCHIVED MODERATION LOG
// Old/resolved ModerationLog entries (> 1 year) are moved here to keep the
// active ModerationLog table lean and performant.
//

model ArchivedModerationLog {
  id String @id @default(cuid())

  // Original fields copied from ModerationLog
  originalId  String         @unique // the original ModerationLog.id
  fromStatus  RebuttalStatus
  toStatus    RebuttalStatus
  notes       String?
  createdAt   DateTime       // original creation timestamp
  archivedAt  DateTime       @default(now())

  // Denormalized references (kept even if parent records soft-deleted)
  moderatorId String
  rebuttalId  String

  @@index([rebuttalId])
  @@index([moderatorId])
  @@index([createdAt])
  @@index([archivedAt])
  @@index([originalId])
}

//
// TEMPLATE LIBRARY
//

enum TemplateCategory {
  REBUTTAL
  CHECKLIST
  GUIDE
}

enum TemplateFileFormat {
  PDF
  DOCX
}

model Template {
  id          String             @id @default(cuid())
  title       String
  description String
  category    TemplateCategory
  fileFormat  TemplateFileFormat
  fileUrl     String             // path or URL to the file
  notionUrl   String?            // optional link to Notion knowledge base page
  isActive    Boolean            @default(true)
  downloadCount Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // UPLOADER (admin)
  uploadedById String?
  uploadedBy   User?   @relation("UploadedTemplates", fields: [uploadedById], references: [id], onDelete: SetNull)

  downloads TemplateDownload[]

  @@index([category])
  @@index([isActive])
  @@index([isActive, category])
  @@index([downloadCount])
  @@index([createdAt])
}

model TemplateDownload {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // WHO downloaded
  userId String
  user   User   @relation("TemplateDownloads", fields: [userId], references: [id], onDelete: Cascade)

  // WHICH template
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([userId])
  @@index([userId, createdAt])
}

//
// TAKEDOWN AND INCIDENT MANAGEMENT SYSTEM (72h SLA & Permanent Compliance Log)
//

enum TakedownStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum TakedownReason {
  PRIVACY_PII_PHI
  INACCURATE_INFORMATION
  DEFAMATION_HARASSMENT
  COURT_ORDER
  COPYRIGHT_IP
  OTHER
}

model TakedownRequest {
  id                  String          @id @default(cuid())
  ticketNumber        String          @unique // e.g. TDR-2026-A1B2
  requesterName       String
  requesterEmail      String
  facilityOrRebuttal  String          // URL, title, or name of affected content
  reason              TakedownReason
  reasonDetails       String?
  supportingInfo      String          // Detailed explanation & evidence
  status              TakedownStatus  @default(PENDING)

  submittedAt         DateTime        @default(now())
  slaDeadline         DateTime        // submittedAt + 72 hours

  assignedToId        String?
  assignedTo          User?           @relation("AssignedTakedowns", fields: [assignedToId], references: [id])

  resolvedAt          DateTime?
  resolvedById        String?
  resolvedBy          User?           @relation("ResolvedTakedowns", fields: [resolvedById], references: [id])
  resolutionNotes     String?

  isEmergencyTakedown Boolean         @default(false)
  emergencyUnpublishedAt DateTime?

  // Direct link to a Rebuttal if specified/matched
  rebuttalId          String?
  rebuttal            Rebuttal?       @relation(fields: [rebuttalId], references: [id], onDelete: SetNull)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
  @@index([submittedAt])
  @@index([slaDeadline])
  @@index([ticketNumber])
  @@index([assignedToId])
  @@index([rebuttalId])
}

//
// ELECTRONIC CONSENT / MEMBERSHIP AGREEMENT
//

model ConsentLog {
  id String @id @default(cuid())

  // WHO SIGNED
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // AGREEMENT INFORMATION
  agreementVersion String
  signedName       String
  email            String

  // AUDIT INFORMATION
  ipAddress String?
  userAgent String?

  // SIGNED DOCUMENT
  documentUrl String?

  signedAt DateTime @default(now())

  @@index([userId])
  @@index([agreementVersion])
  @@index([signedAt])
}
