generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

enum RebuttalStatus {
  PENDING
  APPROVED
  REJECTED
  REQUEST_FIX
}

enum MembershipPlan {
  NONE
  TIER_A
  TIER_B
  TIER_C
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
}

//
// USER
//

model User {
  id       String @id @default(cuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(MEMBER)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastReviewedAt DateTime?

  // RELATIONS
  membership Membership?

  rebuttals          Rebuttal[]
  moderatedRebuttals Rebuttal[] @relation("ModeratedRebuttals")

  createdFacilities Facility[]
  citationDeadlines CitationDeadline[]

  moderationLogs ModerationLog[]

  @@index([email])
}

//
// MEMBERSHIP (STRIPE + TIERS)
//

model Membership {
  id                   String   @id @default(cuid())
  userId               String    @unique

  plan                 MembershipPlan @default(NONE)
  status               MembershipStatus @default(INACTIVE)

  maxFacilities        Int       @default(0)

  stripeCustomerId     String?
  stripeSubscriptionId String?

  startDate            DateTime?
  endDate              DateTime?
  nextBillingDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([status])
}

//
// REBUTTAL SYSTEM
//

model Rebuttal {
  id      String         @id @default(cuid())
  title   String
  content String
  documentUrl String?
  status  RebuttalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // FACILITY LINK
  facilityId String?
  facility   Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  // MODERATION
  moderatedById String?
  moderatedBy   User?   @relation("ModeratedRebuttals", fields: [moderatedById], references: [id])

  moderationLogs ModerationLog[]

  @@index([userId])
  @@index([status])
  @@index([facilityId])
}

//
// FACILITY SYSTEM
//

model Facility {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  address        String
  description    String?
  facilityNumber String?
  city           String?
  county         String?
  capacity       Int?
  ccldLink       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // REBUTTALS
  rebuttals Rebuttal[]

  @@index([slug])
  @@index([name])
  @@index([createdById])
}

//
// MFA SYSTEM
//

model MfaOtp {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime

  attempts  Int      @default(0)
  used      Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([email])
}

//
// CITATION DEADLINE SYSTEM
//

model CitationDeadline {
  id         String   @id @default(cuid())
  citationId String
  dueDate    DateTime
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OWNER
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

//
// MODERATION AUDIT TRAIL
//

model ModerationLog {
  id         String @id @default(cuid())

  // WHAT CHANGED
  fromStatus RebuttalStatus
  toStatus   RebuttalStatus
  notes      String?

  // WHEN
  createdAt  DateTime @default(now())

  // WHO
  moderatorId String
  moderator   User   @relation(fields: [moderatorId], references: [id])

  // WHICH rebuttal
  rebuttalId String
  rebuttal   Rebuttal @relation(fields: [rebuttalId], references: [id], onDelete: Cascade)

  @@index([rebuttalId])
  @@index([moderatorId])
}