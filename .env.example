# Copy to .env.local (local dev) or set in your host's secret store.
# Placeholders only. Never commit real values. See docs/SECRET_ROTATION.md.

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
# docker-compose.yml only: password for the bundled Postgres container.
POSTGRES_PASSWORD="replace-with-a-db-password"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Long random string (e.g. `openssl rand -base64 48`). Rotating it logs everyone out.
JWT_SECRET="replace-with-a-long-random-string"

# ── Email (Nodemailer / Gmail SMTP) ──────────────────────────────────────────
EMAIL_USER="sender@example.org"
EMAIL_PASS="replace-with-app-password"

# ── Stripe (test keys locally, live keys only in production) ─────────────────
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_PRICE_A="price_replace_me"
STRIPE_PRICE_B="price_replace_me"
STRIPE_PRICE_C="price_replace_me"

# ── Public URLs ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_NOTION_KB_URL="https://your-workspace.notion.site/your-knowledge-base"

# ── File storage ─────────────────────────────────────────────────────────────
# Cloudinary: rebuttal document uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="replace-me"
NEXT_PUBLIC_CLOUDINARY_API_KEY="replace-me"
CLOUDINARY_API_SECRET="replace-me"
# UploadThing: member private files. Read by the uploadthing library itself,
# not by name in src/.
UPLOADTHING_TOKEN="replace-me"

# ── Analytics (optional; leave empty to disable Google Analytics) ────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# ── Seed (local/dev only; `npm run db:seed` refuses NODE_ENV=production) ─────
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD="replace-with-12-plus-characters"
SEED_DEMO_PASSWORD="replace-with-12-plus-characters"

# ── Tooling (optional) ───────────────────────────────────────────────────────
# ANALYZE=true enables @next/bundle-analyzer during `next build`.
ANALYZE=""
# NODE_ENV is set by Next.js / your host; do not set it here.
